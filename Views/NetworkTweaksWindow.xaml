<Window x:Class="DotaPingMonitor.Views.NetworkTweaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оптимизация сети и Windows"
        Width="520"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource AccentBlueSoft}" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="⚡" Foreground="{DynamicResource AccentBlue}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="ОПТИМИЗАЦИЯ СЕТИ И WINDOWS" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Width="26" Height="26" Background="Transparent" BorderBrush="Transparent" Click="CloseButton_Click" Cursor="Hand">
                    <TextBlock Text="✕" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </Button>
            </DockPanel>

            <!-- Основной контент -->
            <StackPanel Grid.Row="1">
                <!-- КАРТОЧКА 1: GAME BOOST -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🎮 " FontSize="12"/>
                                <TextBlock x:Name="GbTitle" Text="Игровой режим (Game Boost)" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="GbDesc" Text="Повышает приоритет процесса игры до High и режим I/O, снижая приоритет фоновых браузеров и загрузчиков." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="GameBoostBtn" Grid.Column="1" VerticalAlignment="Center" Height="30" Padding="12,0" Background="{DynamicResource AccentBlueSoft}" BorderBrush="{DynamicResource AccentBlue}" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold" Content="Включить" Click="GameBoostBtn_Click"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 2: ОЧИСТКА DNS -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🚀 " FontSize="12"/>
                                <TextBlock x:Name="FlushDnsTitle" Text="Очистка кэша DNS (Flush DNS)" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="FlushDnsDesc" Text="Сбрасывает устаревшие и зависшие DNS-записи в резолвере Windows." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="FlushDnsBtn" Grid.Column="1" VerticalAlignment="Center" Height="30" Padding="12,0" Background="{DynamicResource BgCardElevated}" BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Content="Очистить" Click="FlushDnsBtn_Click"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 3: NAGLE / TCP NODELAY -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📶 " FontSize="12"/>
                                <TextBlock x:Name="NagleTitle" Text="Оптимизация Nagle (TCP NoDelay)" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="NagleDesc" Text="Отключает склейку TCP пакетов (TcpAckFrequency = 1), минимизируя задержку передачи в онлайн-играх." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="NagleBtn" Grid.Column="1" VerticalAlignment="Center" Height="30" Padding="12,0" Background="{DynamicResource AccentGreenSoft}" BorderBrush="{DynamicResource AccentGreen}" Foreground="{DynamicResource AccentGreen}" FontSize="11" FontWeight="Bold" Content="Применить" Click="NagleBtn_Click"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 4: ПЕРЕЗАПУСК АДАПТЕРА СЕТИ -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔄 " FontSize="12"/>
                                <TextBlock x:Name="AdapterTitle" Text="Перезапуск сетевого адаптера" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="AdapterDesc" Text="Мягко перезапускает сетевой стек при зависании Wi-Fi/Ethernet или потере пакетов." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="RestartAdapterBtn" Grid.Column="1" VerticalAlignment="Center" Height="30" Padding="12,0" Background="{DynamicResource BgCardElevated}" BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Content="Перезапуск" Click="RestartAdapterBtn_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Статус и кнопка закрытия -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusMessageText" Text="" Foreground="{DynamicResource AccentGreen}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Width="90" Height="30" Content="Закрыть" Background="{DynamicResource BgCardElevated}" BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Click="CloseButton_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
