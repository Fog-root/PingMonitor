<Window x:Class="DotaPingMonitor.Views.AddCustomTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить сервер"
        Width="440"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentGreenSoft}" BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="+" Foreground="{DynamicResource AccentGreen}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="ДОБАВИТЬ СВОЙ СЕРВЕР" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Width="26" Height="26" Background="Transparent" BorderBrush="Transparent" Click="CancelButton_Click" Cursor="Hand">
                    <TextBlock Text="✕" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </Button>
            </DockPanel>

            <!-- Поля ввода -->
            <StackPanel Grid.Row="1">
                <!-- Поле 1: Название -->
                <TextBlock x:Name="LabelName" Text="Название сервера или метка:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Height="36" Margin="0,0,0,14">
                    <TextBox x:Name="TargetNameBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" Padding="10,0"/>
                </Border>

                <!-- Поле 2: IP-адрес или домен -->
                <TextBlock x:Name="LabelHost" Text="IP-адрес или доменное имя (IPv4 / Hostname):" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Height="36" Margin="0,0,0,8">
                    <TextBox x:Name="TargetHostBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" Padding="10,0"/>
                </Border>

                <!-- Сообщение об ошибке валидации -->
                <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource AccentRed}" FontSize="10.5" Visibility="Collapsed" Margin="0,0,0,4"/>
            </StackPanel>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="Отмена" Width="90" Height="32" Background="{DynamicResource BgCardElevated}" BorderBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Сохранить" Width="110" Height="32" Background="{DynamicResource AccentGreenSoft}" BorderBrush="{DynamicResource AccentGreen}" Foreground="{DynamicResource AccentGreen}" FontSize="11.5" FontWeight="Bold" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
