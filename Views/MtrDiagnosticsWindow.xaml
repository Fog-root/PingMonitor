<Window x:Class="DotaPingMonitor.Views.MtrDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика сетевых узлов (MTR)"
        Width="780" Height="580"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#07080A"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI, Inter, sans-serif"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border Background="#07080A"
            BorderBrush="#22262C"
            BorderThickness="1"
            CornerRadius="10">

        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Заголовок окна -->
                <RowDefinition Height="Auto"/> <!-- Карточка вердикта -->
                <RowDefinition Height="*"/>    <!-- Список узлов (хопов) -->
                <RowDefinition Height="Auto"/> <!-- Подвал с кнопками -->
            </Grid.RowDefinitions>

            <!-- 1. ЗАГОЛОВОК ОКНА -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1857C1FF" BorderBrush="#3357C1FF" BorderThickness="1"
                                CornerRadius="6" Padding="6,4" Margin="0,0,10,0">
                            <TextBlock Text="MTR" Foreground="#57C1FF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MtrHeaderTitleText"
                                       Text="ДИАГНОСТИКА СЕТЕВЫХ УЗЛОВ И МАРШРУТА"
                                       Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TargetSubtitleText"
                                       Text="Опрос промежуточных узлов до сервера..."
                                       Foreground="#A0A8B4" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Width="28" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="#A0A8B4" Cursor="Hand" Click="CloseButton_Click" ToolTip="Закрыть (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="Tx" Text="✕" FontSize="13" FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#22262C"/>
                                        <Setter TargetName="Tx" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2C323B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Grid>

            <!-- 2. КАРТОЧКА ВЕРДИКТА СЕТИ (RAYCAST DARK) -->
            <Border x:Name="VerdictBorder" Grid.Row="1"
                    Background="#121418"
                    BorderBrush="#22262C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Круглая иконка статуса -->
                    <Border x:Name="VerdictIconContainer" Grid.Column="0"
                            Width="36" Height="36" CornerRadius="18"
                            Background="#1859D499" BorderBrush="#3359D499" BorderThickness="1"
                            VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock x:Name="VerdictIconText" Text="✓"
                                   Foreground="#59D499" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Текстовое описание проблемы -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictTitleText"
                                   Text="Выполняется опрос сетевых узлов..."
                                   Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VerdictDescText"
                                   Text="Проверяем промежуточные узлы: домашний роутер, шлюз провайдера и магистральные каналы..."
                                   Foreground="#A0A8B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <!-- Индикатор прогресса -->
                        <ProgressBar x:Name="MtrProgressBar"
                                     Height="3" Minimum="0" Maximum="25" Value="0"
                                     Background="#181B21" Foreground="#57C1FF" BorderThickness="0"
                                     Margin="0,8,0,0" IsIndeterminate="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. ТАБЛИЦА ХОПОВ (MTR HOP LIST) -->
            <Border Grid.Row="2"
                    Background="#121418"
                    BorderBrush="#22262C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка таблицы -->
                    <Grid Grid.Row="0" Margin="6,2,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>   <!-- Хоп # -->
                            <ColumnDefinition Width="200"/>  <!-- Категория узла -->
                            <ColumnDefinition Width="*"/>    <!-- IP и Hostname -->
                            <ColumnDefinition Width="90"/>   <!-- Пинг -->
                            <ColumnDefinition Width="80"/>   <!-- Потери -->
                            <ColumnDefinition Width="110"/>  <!-- Статус -->
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColHopText" Grid.Column="0" Text="ХОП" Foreground="#606773" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ColNodeText" Grid.Column="1" Text="УЗЕЛ СЕТИ" Foreground="#606773" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ColIpText" Grid.Column="2" Text="IP АДРЕС / PTR ИМЯ" Foreground="#606773" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ColPingText" Grid.Column="3" Text="ОТКЛИК" Foreground="#606773" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ColLossText" Grid.Column="4" Text="ПОТЕРИ" Foreground="#606773" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ColStatusText" Grid.Column="5" Text="СОСТОЯНИЕ" Foreground="#606773" FontSize="10" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Список хопов -->
                    <ListView x:Name="HopsListView" Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CategoryBg}"
                                        BorderBrush="{Binding StatusColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,2"
                                        Padding="6,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Номер хопа -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding HopIndex, StringFormat='#{0:D2}'}"
                                                   Foreground="#A0A8B4"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <!-- Категория с иконкой -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CategoryName}"
                                                       Foreground="{Binding CategoryColor}"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- IP и Hostname -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding IpAddress}"
                                                       Foreground="#FFFFFF"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="11.5" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Hostname}"
                                                       Foreground="#606773"
                                                       FontSize="9.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Hostname, Converter={x:Null}}"/>
                                        </StackPanel>

                                        <!-- Пинг -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PingDisplay}"
                                                   Foreground="#FFFFFF"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <!-- Потери -->
                                        <Border Grid.Column="4"
                                                Background="{Binding LossBg}"
                                                BorderBrush="{Binding LossColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LossDisplay}"
                                                       Foreground="{Binding LossColor}"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Статус -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 4. ПОДВАЛ (КНОПКИ ДЕЙСТВИЙ) -->
            <Grid Grid.Row="3">
                <DockPanel>
                    <TextBlock x:Name="StatusFooterText"
                               Text="Готово к запуску"
                               Foreground="#606773" FontSize="11"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <!-- Кнопка формирования тикета для провайдера -->
                        <Button x:Name="IspTicketButton"
                                Background="#1857C1FF" Foreground="#57C1FF"
                                BorderBrush="#3357C1FF" BorderThickness="1"
                                Padding="12,6" Margin="0,0,8,0"
                                Cursor="Hand" Click="IspTicketButton_Click"
                                ToolTip="Сформировать готовое вежливое обращение и технический отчёт для техподдержки">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="11"/>
                                <TextBlock x:Name="IspTicketBtnText" Text="Тикет для провайдера" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопка копирования отчёта -->
                        <Button x:Name="CopyReportButton"
                                Background="#121418" Foreground="#A0A8B4"
                                BorderBrush="#22262C" BorderThickness="1"
                                Padding="12,6" Margin="0,0,8,0"
                                Cursor="Hand" Click="CopyReportButton_Click" ToolTip="Скопировать детальный MTR-отчёт для техподдержки">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="11"/>
                                <TextBlock x:Name="CopyReportBtnText" Text="Скопировать отчёт" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопка повторного запуска -->
                        <Button x:Name="RestartButton"
                                Background="#121418" Foreground="#57C1FF"
                                BorderBrush="#3357C1FF" BorderThickness="1"
                                Padding="12,6" Margin="0,0,8,0"
                                Cursor="Hand" Click="RestartButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳ " FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="RestartBtnText" Text="Повторить" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопка закрытия -->
                        <Button Background="#1A1D23" Foreground="#FFFFFF"
                                BorderBrush="#353C46" BorderThickness="1"
                                Padding="16,6"
                                Cursor="Hand" Click="CloseButton_Click">
                            <TextBlock x:Name="CloseBtnText" Text="Закрыть" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
