<Window x:Class="DotaPingMonitor.Views.IncidentDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ точки на графике"
        Width="640" Height="560"
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#07080A"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI, Inter, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border Background="#07080A"
            BorderBrush="#22262C"
            BorderThickness="1"
            CornerRadius="10">

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Заголовок -->
                <RowDefinition Height="Auto"/> <!-- 1: Карточка вердикта -->
                <RowDefinition Height="*"/>    <!-- 2: Сетка 3-х уровней сети -->
                <RowDefinition Height="Auto"/> <!-- 3: Баннер с советом -->
                <RowDefinition Height="Auto"/> <!-- 4: Подвал с кнопками -->
            </Grid.RowDefinitions>

            <!-- 0. ЗАГОЛОВОК ОКНА -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1857C1FF" BorderBrush="#3357C1FF" BorderThickness="1"
                                CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                            <TextBlock Text="DIAG" Foreground="#57C1FF" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitleText"
                                       Text="АНАЛИЗ ИНЦИДЕНТА ЗАДЕРЖКИ СЕТИ"
                                       Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TimestampSubtitle"
                                       Text="Замер за 22:00:00 • Сервер: Google DNS"
                                       Foreground="#A0A8B4" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Width="28" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="#A0A8B4" Cursor="Hand" Click="CloseButton_Click" ToolTip="Закрыть (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="Tx" Text="✕" FontSize="13" FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A1D23"/>
                                        <Setter TargetName="Tx" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Grid>

            <!-- 1. КАРТОЧКА ВЕРДИКТА -->
            <Border x:Name="VerdictCard"
                    Grid.Row="1"
                    Background="#121418"
                    BorderBrush="#22262C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="VerdictIconContainer"
                            Grid.Column="0"
                            Width="44" Height="44"
                            CornerRadius="8"
                            Background="#1859D499"
                            BorderBrush="#3359D499"
                            BorderThickness="1"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictIconText"
                                   Text="✓"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictTitleText"
                                   Text="Проблема в домашнем Wi-Fi / роутере"
                                   Foreground="#FFFFFF"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="VerdictDescriptionText"
                                   Text="На локальном шлюзе зафиксирован скачок задержки..."
                                   Foreground="#A0A8B4"
                                   FontSize="11.5"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Замер пинга в тот момент -->
                    <Border Grid.Column="2"
                            Background="#181B21"
                            BorderBrush="#2B303A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="SampleBadgeLabel" Text="ЗАМЕР" Foreground="#606773" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PingBadgeText" Text="142 ms"
                                       Foreground="#FFC533" FontSize="18" FontWeight="Bold"
                                       FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. СЕТКА 3-Х УРОВНЕЙ СЕТИ (РОУТЕР -> ПРОВАЙДЕР -> МАГИСТРАЛЬ) -->
            <Border Grid.Row="2"
                    Background="#0D0E12"
                    BorderBrush="#1A1D23"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SectionBreakdownTitle"
                               Grid.Row="0"
                               Text="РАЗБИВКА СЕТЕВОГО МАРШРУТА ПО СЕГМЕНТАМ"
                               Foreground="#606773"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="2,0,0,10"/>

                    <StackPanel Grid.Row="1">

                        <!-- Сегмент 1: Роутер -->
                        <Border x:Name="RouterRowBorder"
                                Background="#121418"
                                BorderBrush="#22262C"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🏠" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="Seg1Title" Text="1. ДОМАШНИЙ WI-FI / РОУТЕР"
                                               Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RouterIpText" Text="Шлюз: 192.168.0.1"
                                               Foreground="#A0A8B4" FontSize="10.5" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>

                                <TextBlock x:Name="RouterPingText" Grid.Column="2" Text="1 ms"
                                           Foreground="#59D499" FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas, Segoe UI"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <Border x:Name="RouterStatusBadge" Grid.Column="3"
                                        Background="#1859D499" BorderBrush="#3359D499" BorderThickness="1"
                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="RouterStatusBadgeText" Text="✓ Норма"
                                               Foreground="#59D499" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Сегмент 2: Провайдер -->
                        <Border x:Name="IspRowBorder"
                                Background="#121418"
                                BorderBrush="#22262C"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🏢" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="Seg2Title" Text="2. ГОРОДСКОЙ ИНТЕРНЕТ-ПРОВАЙДЕР"
                                               Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IspIpText" Text="Первая миля оператора"
                                               Foreground="#A0A8B4" FontSize="10.5" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>

                                <TextBlock x:Name="IspPingText" Grid.Column="2" Text="5 ms"
                                           Foreground="#59D499" FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas, Segoe UI"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <Border x:Name="IspStatusBadge" Grid.Column="3"
                                        Background="#1859D499" BorderBrush="#3359D499" BorderThickness="1"
                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="IspStatusBadgeText" Text="✓ Норма"
                                               Foreground="#59D499" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Сегмент 3: Магистраль / Сервер -->
                        <Border x:Name="BackboneRowBorder"
                                Background="#121418"
                                BorderBrush="#22262C"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🌐" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="Seg3Title" Text="3. МАГИСТРАЛЬНЫЙ ТРАНЗИТ / СЕРВЕР"
                                               Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TargetIpText" Text="Транзитные узлы до сервера Valve"
                                               Foreground="#A0A8B4" FontSize="10.5" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>

                                <TextBlock x:Name="TargetPingText" Grid.Column="2" Text="142 ms"
                                           Foreground="#FFC533" FontSize="15" FontWeight="Bold"
                                           FontFamily="Consolas, Segoe UI"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <Border x:Name="BackboneStatusBadge" Grid.Column="3"
                                        Background="#18FFC533" BorderBrush="#33FFC533" BorderThickness="1"
                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="BackboneStatusBadgeText" Text="⚠ Скачок"
                                               Foreground="#FFC533" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. БАННЕР С СОВЕТОМ / РЕКОМЕНДАЦИЕЙ -->
            <Border x:Name="RecommendationBorder"
                    Grid.Row="3"
                    Background="#0D0E12"
                    BorderBrush="#22262C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Text="💡 " FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Top"/>
                    <TextBlock x:Name="RecommendationText"
                               Text="Рекомендация: переключитесь на проводной кабель или 5 GHz..."
                               Foreground="#A0A8B4"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- 4. ПОДВАЛ С КНОПКАМИ -->
            <Grid Grid.Row="4">
                <DockPanel LastChildFill="False">
                    <!-- Запустить подробный MTR -->
                    <Button x:Name="RunMtrButton"
                            DockPanel.Dock="Left"
                            Background="#181B21"
                            BorderBrush="#353C46"
                            BorderThickness="1"
                            Foreground="#FFFFFF"
                            Padding="12,6"
                            Cursor="Hand"
                            Click="RunMtrButton_Click"
                            ToolTip="Запустить пошаговый опрос каждого узла на пути следования пакетов">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 " FontSize="12"/>
                            <TextBlock x:Name="RunMtrBtnText" Text="Подробная MTR трассировка всех узлов" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Сформировать тикет для техподдержки -->
                    <Button x:Name="IspTicketButton"
                            DockPanel.Dock="Left"
                            Background="#1857C1FF"
                            BorderBrush="#3357C1FF"
                            BorderThickness="1"
                            Foreground="#57C1FF"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Click="IspTicketButton_Click"
                            ToolTip="Сформировать готовое обращение для техподдержки провайдера">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋 " FontSize="12"/>
                            <TextBlock x:Name="IspTicketBtnText" Text="Тикет для техподдержки" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DismissButton"
                            DockPanel.Dock="Right"
                            Background="#181B21"
                            BorderBrush="#353C46"
                            BorderThickness="1"
                            Foreground="#A0A8B4"
                            Padding="14,6"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <TextBlock x:Name="DismissBtnText" Text="Закрыть" FontSize="11.5" FontWeight="SemiBold"/>
                    </Button>
                </DockPanel>
            </Grid>

        </Grid>

    </Border>

</Window>
