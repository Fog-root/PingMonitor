<Window x:Class="DotaPingMonitor.Views.IspTicketExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт для техподдержки провайдера"
        Width="820" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, sans-serif"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border Background="#07080A"
            BorderBrush="#22262C"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Шапка -->
                <RowDefinition Height="Auto"/> <!-- 1: Быстрые поля абонента -->
                <RowDefinition Height="*"/>    <!-- 2: Поле с текстом отчёта -->
                <RowDefinition Height="Auto"/> <!-- 3: Подвал с кнопками -->
            </Grid.RowDefinitions>

            <!-- 0. ШАПКА ОКНА -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1857C1FF" BorderBrush="#3357C1FF" BorderThickness="1"
                                CornerRadius="6" Padding="7,4" Margin="0,0,10,0">
                            <TextBlock Text="📋" FontSize="13" Foreground="#57C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="СФОРМИРОВАТЬ ОТЧЁТ ДЛЯ ТЕХПОДДЕРЖКИ ПРОВАЙДЕРА"
                                       Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="Готовое обращение к оператору связи с поузловой MTR-трассировкой и логами сбоев"
                                       Foreground="#A0A8B4" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CloseHeaderBtn"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Width="28" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="#A0A8B4" Cursor="Hand" Click="CloseButton_Click" ToolTip="Закрыть (Esc)">
                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DockPanel>
            </Grid>

            <!-- 1. ПОЛЯ ВВОДА ДАННЫХ АБОНЕНТА (ОПЦИОНАЛЬНО ДЛЯ ВСТАВКИ В ТИКЕТ) -->
            <Border Grid.Row="1" Background="#0D0E12" BorderBrush="#1A1D23" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Поле 1: Номер договора -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="LabelContract" Text="Номер договора / лицевой счёт:" Foreground="#A0A8B4" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border Background="#07080A" BorderBrush="#22262C" BorderThickness="1" CornerRadius="5" Height="28">
                            <TextBox x:Name="ContractBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Padding="8,0"
                                     TextChanged="FieldBox_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Поле 2: Адрес подключения -->
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock x:Name="LabelAddress" Text="Адрес подключения (город, улица):" Foreground="#A0A8B4" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border Background="#07080A" BorderBrush="#22262C" BorderThickness="1" CornerRadius="5" Height="28">
                            <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Padding="8,0"
                                     TextChanged="FieldBox_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Поле 3: Телефон -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock x:Name="LabelPhone" Text="Контактный телефон:" Foreground="#A0A8B4" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border Background="#07080A" BorderBrush="#22262C" BorderThickness="1" CornerRadius="5" Height="28">
                            <TextBox x:Name="PhoneBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" Padding="8,0"
                                     TextChanged="FieldBox_TextChanged"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. ОКНО ПРЕДПРОСМОТРА ОТЧЁТА -->
            <Border Grid.Row="2" Background="#0A0B0E" BorderBrush="#22262C" BorderThickness="1" CornerRadius="8" Padding="12">
                <TextBox x:Name="ReportTextBox"
                         Background="Transparent"
                         Foreground="#FFFFFF"
                         BorderThickness="0"
                         FontFamily="Consolas, Cascadia Code, monospace"
                         FontSize="11.5"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         SelectionBrush="#57C1FF"/>
            </Border>

            <!-- 3. ПОДВАЛ (КНОПКИ ДЕЙСТВИЙ) -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock x:Name="StatusInfoText"
                               Text="Готово к отправке в службу поддержки"
                               Foreground="#59D499" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <!-- Кнопка копирования в буфер -->
                        <Button x:Name="CopyTicketBtn"
                                Background="#1859D499" Foreground="#59D499"
                                BorderBrush="#3359D499" BorderThickness="1"
                                Padding="16,7" Margin="0,0,10,0"
                                Cursor="Hand" Click="CopyTicketBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="11"/>
                                <TextBlock x:Name="CopyTicketBtnText" Text="Скопировать обращение" FontSize="11.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопка сохранения в файл -->
                        <Button x:Name="SaveFileBtn"
                                Background="#121418" Foreground="#A0A8B4"
                                BorderBrush="#22262C" BorderThickness="1"
                                Padding="14,7" Margin="0,0,10,0"
                                Cursor="Hand" Click="SaveFileBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 " FontSize="11"/>
                                <TextBlock x:Name="SaveFileBtnText" Text="Сохранить в .txt" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопка закрытия -->
                        <Button Background="#1A1D23" Foreground="#FFFFFF"
                                BorderBrush="#353C46" BorderThickness="1"
                                Padding="18,7"
                                Cursor="Hand" Click="CloseButton_Click">
                            <TextBlock x:Name="CloseBtnText" Text="Закрыть" FontSize="11.5" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
