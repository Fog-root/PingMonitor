<Window x:Class="DotaPingMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DotaPingMonitor.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1080"
        Height="675"
        MinWidth="820"
        MinHeight="530"
        Icon="app.ico"
        Background="{DynamicResource BgPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль неоновой кнопки запуска Спидтеста с темным фоном и дыханием -->
        <Style x:Key="SpeedtestActionButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" HorizontalAlignment="Center">
                            <!-- 1. Внешний неоновый ореол (Glow / Breathing) -->
                            <Border x:Name="GlowBorder"
                                    IsHitTestVisible="False"
                                    CornerRadius="22"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    BorderThickness="1.5"
                                    Opacity="0.30">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="NeonGlow"
                                                      BlurRadius="14"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource AccentColorValue}"
                                                      Opacity="0.40"/>
                                </Border.Effect>
                            </Border>

                            <!-- 2. Темное матовое тело кнопки (#111215) с четкой тонкой рамкой -->
                            <Border x:Name="MainBd"
                                    CornerRadius="22"
                                    Background="#111215"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    BorderThickness="1.2"
                                    Opacity="0.9"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Иконка кнопки (▶ в покое, ■ при тестировании) -->
                                    <TextBlock x:Name="BtnGlyph"
                                               Text="▶ "
                                               FontSize="11"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF" Opacity="0.4"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <!-- Контрастный белый текст кнопки с эффектом text-shadow -->
                                    <TextBlock x:Name="BtnLabel"
                                               Text="{Binding SpeedtestButtonText}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF" Opacity="0.4"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover State: плавно увеличиваем яркость границы и мягкое внешнее свечение, БЕЗ сплошной заливки! -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBd" Property="Background" Value="#171920"/>
                                <Setter TargetName="MainBd" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="MainBd" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>

                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBd" Property="Background" Value="#0C0D10"/>
                                <Setter TargetName="MainBd" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>

                            <!-- Active / Running State: пульсирующее дыхание рамки и неонового ореола -->
                            <DataTrigger Binding="{Binding IsSpeedtestRunning}" Value="True">
                                <Setter TargetName="BtnGlyph" Property="Text" Value="■ "/>
                                <Setter TargetName="BtnGlyph" Property="FontSize" Value="10"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="BreathingStory">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.95"
                                                             Duration="0:0:1.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BreathingStory"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон левой кнопки-стрелки скроллбара графика < (приглушенный, мягкий) -->
        <ControlTemplate x:Key="ChartSbLeftArrowTemplate" TargetType="RepeatButton">
            <Border x:Name="Bd"
                    Width="16" Height="14"
                    Background="#0D0E12"
                    BorderBrush="#171A21"
                    BorderThickness="1"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <Path x:Name="ArrowPath"
                      Data="M 5 2.5 L 2 5.5 L 5 8.5"
                      Stroke="#4B5364"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      SnapsToDevicePixels="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#171A22"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#252A36"/>
                    <Setter TargetName="ArrowPath" Property="Stroke" Value="#8A92A0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#1E2330"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#57C1FF"/>
                    <Setter TargetName="ArrowPath" Property="Stroke" Value="#57C1FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Шаблон правой кнопки-стрелки скроллбара графика > (приглушенный, мягкий) -->
        <ControlTemplate x:Key="ChartSbRightArrowTemplate" TargetType="RepeatButton">
            <Border x:Name="Bd"
                    Width="16" Height="14"
                    Background="#0D0E12"
                    BorderBrush="#171A21"
                    BorderThickness="1"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <Path x:Name="ArrowPath"
                      Data="M 2 2.5 L 5 5.5 L 2 8.5"
                      Stroke="#4B5364"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      SnapsToDevicePixels="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#171A22"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#252A36"/>
                    <Setter TargetName="ArrowPath" Property="Stroke" Value="#8A92A0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#1E2330"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#57C1FF"/>
                    <Setter TargetName="ArrowPath" Property="Stroke" Value="#57C1FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Прозрачные кнопки шага по страницам на треке -->
        <Style x:Key="ChartSbPageBtn" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ползунок-слайдер (Thumb) скроллбара графика: цвет #2A2F3A точно как в списке истории -->
        <Style x:Key="ChartSbThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T"
                                Background="#2A2F3A"
                                CornerRadius="2.5"
                                Margin="0,1"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#4B5364"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#555E72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="T" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Горизонтальный скроллбар графика -->
        <Style x:Key="ChartHorizontalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая кнопка со стрелкой < (Назад в прошлое) -->
                            <RepeatButton Grid.Column="0"
                                          Command="ScrollBar.LineLeftCommand"
                                          Cursor="Hand"
                                          Template="{StaticResource ChartSbLeftArrowTemplate}"
                                          ToolTip="Назад в историю (на 5 сек)"/>

                            <!-- Канал трека со слайдером Thumb -->
                            <Border Grid.Column="1"
                                    Background="#08090C"
                                    BorderBrush="#14171E"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="3,0"
                                    Padding="1,0">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ChartSbPageBtn}"
                                                      Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ChartSbThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ChartSbPageBtn}"
                                                      Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>

                            <!-- Правая кнопка со стрелкой > (Вперед к эфиру) -->
                            <RepeatButton Grid.Column="2"
                                          Command="ScrollBar.LineRightCommand"
                                          Cursor="Hand"
                                          Template="{StaticResource ChartSbRightArrowTemplate}"
                                          ToolTip="Вперед к эфиру (на 5 сек)"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgPrimary}" Tag="{Binding IsOptimizedMode}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тонкая верхняя статусная линия (Hairline Glow) -->
        <Rectangle x:Name="TopGlowBar" Height="2" VerticalAlignment="Top" Panel.ZIndex="10" Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="TopGlowBrush" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="TopGlowStop1" Color="#005E6AD2" Offset="0"/>
                    <GradientStop x:Name="TopGlowStop2" Color="#5E6AD2" Offset="0.3"/>
                    <GradientStop x:Name="TopGlowStop3" Color="#8E98FF" Offset="0.7"/>
                    <GradientStop x:Name="TopGlowStop4" Color="#005E6AD2" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Радиальное фоновое освещение темы (Theme Ambient Radial Glow) -->
        <Rectangle x:Name="AmbientGlowRect" Height="260" VerticalAlignment="Top" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="0"
                   Fill="{DynamicResource ThemeAmbientRadialGlow}" Opacity="0.85"/>


        <!-- =============== HEADER (RAYCAST SURFACES) =============== -->

        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ВЕРХНИЙ РЯД: Логотип слева | Сервер, тема, Оптимизация и MTR справа -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- Меню разделов (3 полоски, гамбургер) + Логотип и заголовок -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">

                    <!-- Кнопка навигационного меню (3 полоски, гамбургер по дизайну пользователя) -->
                    <Border x:Name="NavMenuButton"
                            Width="28" Height="28"
                            BorderBrush="{DynamicResource AccentBlue}"
                            BorderThickness="1.5"
                            CornerRadius="7"
                            Cursor="Hand"
                            ToolTip="{Binding LocNavMenuTooltip}"
                            PreviewMouseLeftButtonDown="NavMenuButton_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="NavMenuButton_PreviewMouseLeftButtonUp"
                            PreviewMouseRightButtonUp="NavMenuButton_PreviewMouseRightButtonUp"
                            Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BgCardElevated}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="14" Height="2" Background="{DynamicResource AccentBlue}" CornerRadius="1" Margin="0,0,0,2.5"/>
                            <Border Width="14" Height="2" Background="{DynamicResource AccentBlue}" CornerRadius="1" Margin="0,0,0,2.5"/>
                            <Border Width="14" Height="2" Background="{DynamicResource AccentBlue}" CornerRadius="1"/>
                        </StackPanel>
                    </Border>

                    <!-- Всплывающее меню переключения разделов -->
                    <Popup x:Name="NavMenuPopup"
                           PlacementTarget="{Binding ElementName=NavMenuButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           IsOpen="{Binding IsNavMenuOpen, Mode=TwoWay}"
                           Closed="NavMenuPopup_Closed">
                        <Border x:Name="NavMenuBorder"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="6"
                                Margin="0,4,0,0"
                                MinWidth="250">
                            <Border.Effect>
                                <DynamicResource ResourceKey="MenuDropShadow"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding LocNavSections}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10" FontWeight="Bold"
                                           Margin="8,4,8,6"/>

                                <!-- Пункт 1: Dota 2 Ping -->
                                <Border x:Name="NavDotaPingItem"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,4"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="NavDotaPingItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="NavDotaPingItem_PreviewMouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="◆" Foreground="{DynamicResource AccentGreen}" FontSize="15" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NavGamePingTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LocNavPingDesc}" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Visibility="{Binding DotaPingVisibility}"
                                                Background="{DynamicResource AccentGreenSoft}"
                                                CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LocNavActive}" Foreground="{DynamicResource AccentGreen}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Пункт 2: Диспетчер задач -->
                                <Border x:Name="NavTaskManagerItem"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="NavTaskManagerItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="NavTaskManagerItem_PreviewMouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚡" Foreground="{DynamicResource AccentBlue}" FontSize="14" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LocNavTmTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LocNavTmDesc}" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Visibility="{Binding TaskManagerVisibility}"
                                                Background="{DynamicResource AccentBlueSoft}"
                                                CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LocNavActive}" Foreground="{DynamicResource AccentBlue}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Пункт 3: Спидтест сети -->
                                <Border x:Name="NavSpeedtestItem"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,4,0,0"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="NavSpeedtestItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="NavSpeedtestItem_PreviewMouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⏱" Foreground="{DynamicResource AccentYellow}" FontSize="15" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LocNavSpeedtestTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LocNavSpeedtestDesc}" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Visibility="{Binding SpeedtestVisibility}"
                                                Background="{DynamicResource AccentYellowSoft}"
                                                CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LocNavActive}" Foreground="{DynamicResource AccentYellow}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Разделитель секций -->
                                <Border Height="1"
                                        Background="{DynamicResource BorderSubtle}"
                                        Margin="4,8,4,8"/>

                                <!-- Секция настроек: Язык интерфейса -->
                                <Grid Margin="8,2,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="🌐"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LocLanguage}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <!-- Segmented Toggle: RU | EN -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BgInput}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="26"
                                            Padding="2"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding LocLanguageTooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="7,2" Cursor="Hand" Background="{Binding LangRuBg}" MouseLeftButtonDown="LangRu_Click">
                                                <TextBlock Text="RU" FontSize="10.5" FontWeight="{Binding LangRuFontWeight}" Foreground="{Binding LangRuFg}"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="7,2" Cursor="Hand" Background="{Binding LangEnBg}" MouseLeftButtonDown="LangEn_Click">
                                                <TextBlock Text="EN" FontSize="10.5" FontWeight="{Binding LangEnFontWeight}" Foreground="{Binding LangEnFg}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Иконка активного раздела -->
                    <Border x:Name="HeaderLogoBorder"
                            Width="28" Height="28"
                            CornerRadius="7"
                            Background="{DynamicResource BgCardElevated}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Margin="0,0,6,0">
                        <TextBlock x:Name="HeaderLogoGlyph"
                                   Text="{Binding HeaderLogoGlyph}"
                                   Foreground="{Binding HeaderLogoForeground}"
                                   FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI, sans-serif"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderTitleText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="HeaderLiveBadgeBorder"
                                    Background="{DynamicResource AccentGreenSoft}"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderLiveBadgeText"
                                           Text="LIVE"
                                           Foreground="{DynamicResource AccentGreen}"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding HeaderSubtitleText}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="10"
                                   MaxWidth="160"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Тонкий разделитель между брендингом и выбором игры -->
                    <Border Width="1" Height="20"
                            Background="{DynamicResource BorderSubtle}"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding DotaPingVisibility}"/>

                    <!-- Выпадающий селектор выбора игры (Linear Dark Dropdown) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding DotaPingVisibility}">
                        <TextBlock Text="{Binding LocGame}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>

                        <ComboBox x:Name="GameCombo"
                                  Width="135"
                                  Height="28"
                                  MaxDropDownHeight="360"
                                  ItemsSource="{Binding AvailableGames}"
                                  SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  ToolTip="{Binding LocGameComboTooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   Foreground="{Binding IconBrush}"
                                                   FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI, sans-serif"
                                                   FontSize="12"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>

                <!-- Панель управления и селектор сервера (Колонка 1: выровнена строго вправо) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding DotaPingVisibility}">

                    <!-- Селектор сервера, темы, Оптимизация и MTR -->
                    <TextBlock Text="{Binding LocServer}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>

                    <ComboBox x:Name="ServerCombo"
                              Width="170"
                              Height="28"
                              ItemsSource="{Binding PingTargets}"
                              SelectedItem="{Binding SelectedPingTarget}"
                              DropDownOpened="ServerCombo_DropDownOpened">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center"
                                      Background="Transparent"
                                      ContextMenuOpening="ServerItem_ContextMenuOpening">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Background="#111317" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                            <MenuItem Header="{Binding DeleteTooltip}"
                                                      Foreground="{DynamicResource AccentRed}"
                                                      Click="DeleteCustomServerMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="✕" Foreground="{DynamicResource AccentRed}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding QualityTooltip}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding QualityTooltip}">
                                        <!-- Значение задержки (мс) -->
                                        <TextBlock Text="{Binding PingBadgeText}"
                                                   Foreground="{Binding PingBadgeForeground}"
                                                   FontSize="10"
                                                   FontFamily="Consolas, Segoe UI Mono, monospace"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <!-- 3 вертикальные полоски уровня сигнала -->
                                        <StackPanel Orientation="Horizontal"
                                                      VerticalAlignment="Bottom"
                                                      Height="13">
                                            <!-- Полоска 1: низкая -->
                                            <Border Width="3" Height="4.5"
                                                    CornerRadius="1"
                                                    Background="{Binding Bar1Brush}"
                                                    Opacity="{Binding Bar1Opacity}"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,1.5,0"/>
                                            <!-- Полоска 2: средняя -->
                                            <Border Width="3" Height="8.5"
                                                    CornerRadius="1"
                                                    Background="{Binding Bar2Brush}"
                                                    Opacity="{Binding Bar2Opacity}"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,1.5,0"/>
                                            <!-- Полоска 3: высокая -->
                                            <Border Width="3" Height="12.5"
                                                    CornerRadius="1"
                                                    Background="{Binding Bar3Brush}"
                                                    Opacity="{Binding Bar3Opacity}"
                                                    VerticalAlignment="Bottom"/>
                                        </StackPanel>

                                        <!-- Кнопка удаления пользовательского сервера -->
                                        <Button x:Name="DeleteServerItemBtn"
                                                Width="18" Height="18"
                                                Margin="6,0,0,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Foreground="{DynamicResource AccentRed}"
                                                PreviewMouseLeftButtonDown="DeleteCustomServerItem_PreviewMouseLeftButtonDown"
                                                Click="DeleteCustomServerItem_Click"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTip="{Binding DeleteTooltip}"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <TextBlock Text="✕"
                                                                               Foreground="{TemplateBinding Foreground}"
                                                                               FontSize="9.5"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#25FF6161"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Кнопка добавления своего сервера (+) -->
                    <Button x:Name="AddCustomServerBtn"
                            Width="26" Height="28"
                            Margin="3,0,0,0"
                            Padding="0"
                            Background="{DynamicResource BgCardElevated}"
                            BorderBrush="{DynamicResource BorderColor}"
                            Foreground="{DynamicResource AccentGreen}"
                            Command="{Binding AddCustomServerCommand}"
                            ToolTip="{Binding LocAddCustomServerTooltip}"
                            Cursor="Hand">
                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Кнопка удаления выбранного пользовательского сервера (✕) -->
                    <Button x:Name="DeleteCustomServerBtn"
                            Width="26" Height="28"
                            Margin="3,0,0,0"
                            Padding="0"
                            Background="{DynamicResource BgCardElevated}"
                            BorderBrush="{DynamicResource BorderColor}"
                            Foreground="{DynamicResource AccentRed}"
                            Command="{Binding DeleteCustomServerCommand}"
                            CommandParameter="{Binding SelectedPingTarget}"
                            Visibility="{Binding IsCustomTargetSelected, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="{Binding LocDeleteCustomServerTooltip}"
                            Cursor="Hand">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Выбор темы оформления -->
                    <TextBlock Text="{Binding LocTheme}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="6,0,4,0"/>

                    <ComboBox x:Name="ThemeCombo"
                              Width="125"
                              Height="28"
                              MaxDropDownHeight="360"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                            Margin="0,0,8,0"
                                            Background="{Binding PreviewBrush}"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="0.8"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Кнопка режима оптимизации -->
                    <Button x:Name="OptimizationBtn"
                            Height="28"
                            Padding="6,0"
                            Margin="5,0,0,0"
                            Background="{Binding OptimizationButtonBackground}"
                            BorderBrush="{Binding OptimizationButtonBorderBrush}"
                            Foreground="{Binding OptimizationButtonForeground}"
                            Command="{Binding ToggleOptimizationModeCommand}"
                            ToolTip="{Binding OptimizationButtonToolTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6"
                                     Fill="{Binding OptimizationStatusDotBrush}"
                                     Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding OptimizationButtonText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка MTR Диагностика -->
                    <Button x:Name="MtrDiagnosticsBtn"
                            Height="28"
                            Padding="6,0"
                            Margin="5,0,0,0"
                            Command="{Binding OpenMtrDiagnosticsCommand}"
                            ToolTip="{Binding LocMtrTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 " FontSize="11"/>
                            <TextBlock Text="{Binding LocMtr}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка Отчёт для техподдержки (ISP Ticket Export) -->
                    <Button x:Name="IspTicketBtn"
                            Height="28"
                            Padding="6,0"
                            Margin="5,0,0,0"
                            Background="{DynamicResource BgCardElevated}"
                            BorderBrush="{DynamicResource BorderColor}"
                            Foreground="#57C1FF"
                            Command="{Binding OpenIspTicketExportCommand}"
                            ToolTip="{Binding LocIspTicketTooltip}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋 " FontSize="11"/>
                            <TextBlock Text="{Binding LocIspTicketButton}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка Авто-катка Dota 2 (отображается только для Dota 2) -->
                    <Button x:Name="AutoMatchBtn"
                            Height="28"
                            Padding="6,0"
                            Margin="5,0,0,0"
                            Visibility="{Binding DotaAutoMatchButtonVisibility}"
                            Background="{Binding AutoMatchButtonBackground}"
                            BorderBrush="{Binding AutoMatchButtonBorderBrush}"
                            BorderThickness="1"
                            Command="{Binding ToggleAutoDetectDotaMatchCommand}"
                            ToolTip="{Binding LocDotaAutoMatchTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AutoMatchButtonText}"
                                        Foreground="{Binding AutoMatchButtonForeground}"
                                        FontSize="11"
                                        FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка Оптимизация сети и Windows -->
                    <Button x:Name="NetworkTweaksBtn"
                            Height="28"
                            Padding="6,0"
                            Margin="5,0,0,0"
                            Background="{DynamicResource BgCardElevated}"
                            BorderBrush="{DynamicResource BorderColor}"
                            Foreground="{DynamicResource AccentBlue}"
                            Command="{Binding OpenNetworkTweaksCommand}"
                            ToolTip="{Binding LocNetworkTweaksTooltip}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ " FontSize="11" Foreground="{DynamicResource AccentBlue}"/>
                            <TextBlock Text="{Binding LocNetworkTweaksButton}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Панель управления Диспетчера задач (Колонка 1: выровнена строго вправо) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding TaskManagerVisibility}">

                    <!-- Поиск процессов -->
                    <Border Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="28"
                            Padding="8,0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocSearchPlaceholder}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TmSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="TmSearchBox"
                                     Width="190"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource AccentBlue}"
                                     FontSize="11.5"
                                     VerticalAlignment="Center"
                                     Text="{Binding SearchProcessFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <!-- Кнопка: Снять задачу -->
                    <Button Height="28"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Background="{DynamicResource AccentRedSoft}"
                            Foreground="{DynamicResource AccentRed}"
                            BorderBrush="{DynamicResource AccentRed}"
                            BorderThickness="1"
                            Command="{Binding EndTaskCommand}"
                            ToolTip="{Binding LocEndTaskTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✕ " FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LocEndTask}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Открыть папку процесса -->
                    <Button Height="28"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Command="{Binding OpenProcessLocationCommand}"
                            ToolTip="{Binding LocFolderTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁 " FontSize="11"/>
                            <TextBlock Text="{Binding LocFolder}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Режим экстремальной производительности («Оптимизировать» / «Обычный режим») -->
                    <Button x:Name="TmOptimizationBtn"
                            Height="28"
                            Padding="8,0"
                            Margin="0,0,8,0"
                            Background="{Binding OptimizationButtonBackground}"
                            BorderBrush="{Binding OptimizationButtonBorderBrush}"
                            Foreground="{Binding OptimizationButtonForeground}"
                            Command="{Binding ToggleOptimizationModeCommand}"
                            ToolTip="{Binding OptimizationButtonToolTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6"
                                     Fill="{Binding OptimizationStatusDotBrush}"
                                     Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding OptimizationButtonText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Обновить -->
                    <Button Height="28"
                            Padding="10,0"
                            Command="{Binding RefreshTaskManagerCommand}"
                            ToolTip="{Binding LocRefreshTmTooltip}">
                        <TextBlock Text="{Binding LocRefresh}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>

                <!-- Панель управления Спидтеста (Колонка 1: выровнена строго вправо) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding SpeedtestVisibility}">

                    <!-- Выбор темы оформления -->
                    <TextBlock Text="{Binding LocTheme}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>

                    <ComboBox Width="125"
                              Height="28"
                              MaxDropDownHeight="360"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                            Margin="0,0,8,0"
                                            Background="{Binding PreviewBrush}"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="0.8"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Кнопка режима оптимизации -->
                    <Button Height="28"
                            Padding="8,0"
                            Margin="0,0,8,0"
                            Background="{Binding OptimizationButtonBackground}"
                            BorderBrush="{Binding OptimizationButtonBorderBrush}"
                            Foreground="{Binding OptimizationButtonForeground}"
                            Command="{Binding ToggleOptimizationModeCommand}"
                            ToolTip="{Binding OptimizationButtonToolTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6"
                                     Fill="{Binding OptimizationStatusDotBrush}"
                                     Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding OptimizationButtonText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Очистить историю -->
                    <Button Height="28"
                            Padding="10,0"
                            Command="{Binding ClearSpeedtestHistoryCommand}"
                            ToolTip="{Binding LocSpeedtestClearHistory}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗑 " FontSize="11"/>
                            <TextBlock Text="{Binding LocSpeedtestClearHistory}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>

            <!-- НИЖНИЙ РЯД: Управление HUD-оверлеем и интерактивные хоткеи -->
            <Border Grid.Row="1"
                    Visibility="{Binding DotaPingVisibility}"
                    Margin="0,8,0,0"
                    Padding="0,6,0,0"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">

                    <!-- Кнопка включения/управления HUD оверлеем -->
                    <Button x:Name="ToggleOverlayBtn"
                            DockPanel.Dock="Left"
                            Height="26"
                            Padding="8,0"
                            Margin="0,0,10,0"
                            Command="{Binding ToggleOverlayCommand}"
                            ToolTip="{Binding OverlayButtonToolTip}">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="HudContextMenu_Opened"
                                         Background="#111317" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <MenuItem Header="{Binding MenuLayoutHeader}">
                                    <MenuItem Header="{Binding MenuPresetClassicBarHeader}" Command="{Binding SetOverlayPresetCommand}" CommandParameter="classic_bar"/>
                                    <MenuItem Header="{Binding MenuPresetMinimalHeader}" Command="{Binding SetOverlayPresetCommand}" CommandParameter="minimal"/>
                                    <MenuItem Header="{Binding MenuPresetVerticalStackHeader}" Command="{Binding SetOverlayPresetCommand}" CommandParameter="vertical_stack"/>
                                    <MenuItem Header="{Binding MenuPresetNetGraphHeader}" Command="{Binding SetOverlayPresetCommand}" CommandParameter="net_graph"/>
                                    <MenuItem Header="{Binding MenuPresetCyberHudHeader}" Command="{Binding SetOverlayPresetCommand}" CommandParameter="cyber_hud"/>
                                </MenuItem>
                                <MenuItem Header="{Binding MenuOpacityHeader}">
                                    <MenuItem Header="{Binding MenuOpacity100Header}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="1.00"/>
                                    <MenuItem Header="{Binding MenuOpacity85Header}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.85"/>
                                    <MenuItem Header="{Binding MenuOpacity75Header}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.75"/>
                                    <MenuItem Header="{Binding MenuOpacity50Header}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.50"/>
                                    <MenuItem Header="{Binding MenuOpacity25Header}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.25"/>
                                </MenuItem>
                                <Separator Background="{StaticResource BorderColor}"/>
                                <MenuItem Header="{Binding MenuScaleHeader}" FontWeight="SemiBold" IsEnabled="False" Foreground="#7A8391"/>
                                <MenuItem Header="{Binding MenuScale75Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="0.75"/>
                                <MenuItem Header="{Binding MenuScale90Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="0.90"/>
                                <MenuItem Header="{Binding MenuScale100Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="1.00"/>
                                <MenuItem Header="{Binding MenuScale115Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="1.15"/>
                                <MenuItem Header="{Binding MenuScale130Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="1.30"/>
                                <MenuItem Header="{Binding MenuScale150Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="1.50"/>
                                <MenuItem Header="{Binding MenuScale180Header}" Command="{Binding SetScalePresetCommand}" CommandParameter="1.80"/>
                                <Separator Background="{StaticResource BorderColor}"/>
                                <MenuItem Header="{Binding MenuSparklineHeader}" Command="{Binding ToggleSparklineCommand}"/>
                                <MenuItem Header="{Binding MenuFpsHeader}" Command="{Binding ToggleFpsCommand}"/>
                                <MenuItem Header="{Binding MenuCpuHeader}" Command="{Binding ToggleCpuCommand}"/>
                                <MenuItem Header="{Binding MenuGpuHeader}" Command="{Binding ToggleGpuCommand}"/>
                                <MenuItem Header="{Binding MenuRamHeader}" Command="{Binding ToggleRamCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="OverlayStatusDot"
                                     Width="6" Height="6"
                                     Fill="{Binding OverlayStatusDotBrush}"
                                     Margin="0,0,5,0"/>
                            <TextBlock x:Name="OverlayBtnText"
                                       Text="{Binding OverlayButtonText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Интерактивная плашка хоткеев HUD с динамической подсветкой статуса -->
                    <Border x:Name="HkContainerBorder"
                            DockPanel.Dock="Left"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Хоткей 1: Вкл/выкл оверлея (ПКМ — переназначить) -->
                            <Border x:Name="HkOverlayBorder"
                                    Background="{Binding HkOverlayBg}"
                                    BorderBrush="{Binding HkOverlayBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkOverlayBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkOverlayBorder_MouseRightButtonDown"
                                    ToolTip="Включить / скрыть HUD-оверлей&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleOverlayCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkOverlayText"
                                           Text="{Binding HkOverlayText}"
                                           Foreground="{Binding HkOverlayForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkOverlayStatus"
                                       Text="{Binding HkOverlayStatusText}"
                                       Foreground="{Binding HkOverlayStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkOverlayBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,6,0"/>

                            <!-- Тонкий микро-разделитель -->
                            <Rectangle Width="1" Height="10"
                                       Fill="{StaticResource BorderColor}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <!-- Хоткей 2: Фиксация / сквозные клики (ПКМ — переназначить) -->
                            <Border x:Name="HkLockBorder"
                                    Background="{Binding HkLockBg}"
                                    BorderBrush="{Binding HkLockBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkLockBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkLockBorder_MouseRightButtonDown"
                                    ToolTip="Зафиксировать / разблокировать для сквозных кликов&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleLockCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkLockText"
                                           Text="{Binding HkLockText}"
                                           Foreground="{Binding HkLockForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkLockStatus"
                                       Text="{Binding HkLockStatusText}"
                                       Foreground="{Binding HkLockStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkLockBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,6,0"/>

                            <!-- Тонкий микро-разделитель -->
                            <Rectangle Width="1" Height="10"
                                       Fill="{StaticResource BorderColor}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <!-- Хоткей 3: График кардиограммы (ПКМ — переназначить) -->
                            <Border x:Name="HkSparklineBorder"
                                    Background="{Binding HkSparklineBg}"
                                    BorderBrush="{Binding HkSparklineBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkSparklineBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkSparklineBorder_MouseRightButtonDown"
                                    ToolTip="Включить / скрыть мини-график кардиограммы в HUD&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSparklineCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkSparklineText"
                                           Text="{Binding HkSparklineText}"
                                           Foreground="{Binding HkSparklineForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkSparklineStatus"
                                       Text="{Binding HkSparklineStatusText}"
                                       Foreground="{Binding HkSparklineStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkSparklineBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,6,0"/>

                            <!-- Тонкий микро-разделитель -->
                            <Rectangle Width="1" Height="10"
                                       Fill="{StaticResource BorderColor}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <!-- Хоткей 4: Кадры в секунду FPS (ПКМ — переназначить) -->
                            <Border x:Name="HkFpsBorder"
                                    Background="{Binding HkFpsBg}"
                                    BorderBrush="{Binding HkFpsBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkFpsBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkFpsBorder_MouseRightButtonDown"
                                    ToolTip="Включить / скрыть отображение FPS в HUD&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleFpsCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkFpsText"
                                           Text="{Binding HkFpsText}"
                                           Foreground="{Binding HkFpsForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkFpsStatus"
                                       Text="{Binding HkFpsStatusText}"
                                       Foreground="{Binding HkFpsStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkFpsBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,6,0"/>

                            <!-- Тонкий микро-разделитель -->
                            <Rectangle Width="1" Height="10"
                                       Fill="{StaticResource BorderColor}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <!-- Хоткей 5: Нагрузка ЦП CPU (ПКМ — переназначить) -->
                            <Border x:Name="HkCpuBorder"
                                    Background="{Binding HkCpuBg}"
                                    BorderBrush="{Binding HkCpuBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkCpuBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkCpuBorder_MouseRightButtonDown"
                                    ToolTip="Включить / скрыть отображение нагрузки ЦП (CPU) в HUD&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCpuCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkCpuText"
                                           Text="{Binding HkCpuText}"
                                           Foreground="{Binding HkCpuForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkCpuStatus"
                                       Text="{Binding HkCpuStatusText}"
                                       Foreground="{Binding HkCpuStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkCpuBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,6,0"/>

                            <!-- Тонкий микро-разделитель -->
                            <Rectangle Width="1" Height="10"
                                       Fill="{StaticResource BorderColor}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <!-- Хоткей 6: Нагрузка ГП GPU (ПКМ — переназначить) -->
                            <Border x:Name="HkGpuBorder"
                                    Background="{Binding HkGpuBg}"
                                    BorderBrush="{Binding HkGpuBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkGpuBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkGpuBorder_MouseRightButtonDown"
                                    ToolTip="Включить / скрыть отображение нагрузки ГП (GPU) в HUD&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleGpuCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkGpuText"
                                           Text="{Binding HkGpuText}"
                                           Foreground="{Binding HkGpuForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkGpuStatus"
                                       Text="{Binding HkGpuStatusText}"
                                       Foreground="{Binding HkGpuStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkGpuBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,6,0"/>

                            <!-- Тонкий микро-разделитель -->
                            <Rectangle Width="1" Height="10"
                                       Fill="{StaticResource BorderColor}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>

                            <!-- Хоткей 7: Оперативная память RAM (ПКМ — переназначить) -->
                            <Border x:Name="HkRamBorder"
                                    Background="{Binding HkRamBg}"
                                    BorderBrush="{Binding HkRamBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="HkRamBorder_MouseLeftButtonDown"
                                    MouseRightButtonDown="HkRamBorder_MouseRightButtonDown"
                                    ToolTip="Включить / скрыть отображение оперативной памяти (ОЗУ) в HUD&#x0a;ЛКМ — переключить | ПКМ — настроить горячую клавишу">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleRamCommand}"/>
                                </Border.InputBindings>
                                <TextBlock x:Name="HkRamText"
                                           Text="{Binding HkRamText}"
                                           Foreground="{Binding HkRamForeground}"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="HkRamStatus"
                                       Text="{Binding HkRamStatusText}"
                                       Foreground="{Binding HkRamStatusForeground}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseRightButtonDown="HkRamBorder_MouseRightButtonDown"
                                       ToolTip="ПКМ — настроить горячую клавишу"
                                       Margin="3,0,0,0"/>

                        </StackPanel>
                    </Border>

                    <!-- Подсказка управления справа -->
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding LocHotkeyHint}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                </DockPanel>
            </Border>

        </Grid>

        </Border>


        <!-- =============== MAIN CONTENT (РЕЗИНОВЫЙ ДАШБОРД) =============== -->

        <Grid x:Name="DotaPingViewContainer"
              Grid.Row="1"
              Margin="18,10,18,14"
              Visibility="{Binding DotaPingVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hero Ping + Метрики -->
                <RowDefinition Height="Auto"/> <!-- График -->
                <RowDefinition Height="*"/>    <!-- SDR + История: тянется на весь экран -->
            </Grid.RowDefinitions>


            <!-- ===== СТРОКА 1: БАННЕР МАТЧА DOTA 2 + HERO PING + 4 МЕТРИКИ ===== -->

            <StackPanel Grid.Row="0" Margin="0,0,0,10">

                <!-- ПРЕДУПРЕЖДЕНИЕ: DOTA 2 ЗАПУЩЕНА БЕЗ ЗАПИСИ КОНСОЛИ В ФАЙЛ -->
                <Border x:Name="DotaLogWarningBanner"
                        Visibility="{Binding DotaLogWarningVisibility}"
                        Background="#1C180A"
                        BorderBrush="#664D14"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,9"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Иконка предупреждения -->
                        <Border Grid.Column="0" 
                                Background="#26FFC533" 
                                BorderBrush="#FFC533" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Width="26" Height="26" 
                                Margin="0,0,12,0" 
                                VerticalAlignment="Center">
                            <TextBlock Text="⚠" 
                                       Foreground="#FFC533" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Текстовое пояснение -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="{Binding LocDotaLogWarningTitle}"
                                           Foreground="#FFC533"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CopyConLogStatusText}"
                                           Foreground="#59D499"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LocDotaLogWarningText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <Border Background="#14171C" 
                                        BorderBrush="#353C46" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="6,1" 
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="con_logfile console.log"
                                               Foreground="#57C1FF"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding LocDotaLogWarningTip}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10.5"
                                           FontStyle="Italic"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Кнопка Скопировать команду -->
                            <Button Command="{Binding CopyConLogCommand}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Background="#26FFC533"
                                    BorderBrush="#FFC533"
                                    ToolTip="Скопировать 'con_logfile console.log' в буфер обмена для вставки в консоль Dota 2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋 " FontSize="11" Foreground="#FFC533"/>
                                    <TextBlock Text="{Binding LocDotaCopyCommand}" Foreground="#FFC533" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Кнопка Скопировать -condebug -->
                            <Button Command="{Binding CopyConDebugCommand}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource BgCardElevated}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    ToolTip="Скопировать '-condebug' для параметров запуска Dota 2 в Steam">
                                <TextBlock Text="{Binding LocDotaCopyCondebug}" Foreground="{DynamicResource TextSecondary}" FontSize="10.5"/>
                            </Button>

                            <!-- Закрыть баннер -->
                            <Button Command="{Binding DismissDotaLogWarningCommand}"
                                    Width="26" Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    ToolTip="Скрыть предупреждение">
                                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- БАННЕР АКТИВНОГО МАТЧА DOTA 2 -->
                <Border x:Name="DotaMatchBanner"
                        Visibility="{Binding DotaMatchBannerVisibility}"
                        Background="#0D1A14"
                        BorderBrush="#3359D499"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая часть: Бейдж + Сервер + Релей -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2059D499"
                                    BorderBrush="#59D499"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#59D499" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding LocDotaInMatch}"
                                               Foreground="#59D499"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding LocDotaMatchServer}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DotaMatchServerText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <TextBlock Text="{Binding LocDotaMatchRelay}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DotaMatchRelayText}"
                                       Foreground="#57C1FF"
                                       FontSize="11"
                                       FontFamily="Consolas, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Правая часть: Потери в матче + Время матча -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocDotaMatchLoss}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DotaMatchLossText}"
                                       Foreground="{Binding DotaMatchLossForeground}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Segoe UI"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <Border Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock Text="{Binding DotaMatchDurationText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10.5"
                                           FontFamily="Consolas, Segoe UI"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- HERO PING (СЛЕВА) + 5 КАРТОЧЕК МЕТРИК (СПРАВА) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ТЕКУЩИЙ PING HERO -->
                    <Border x:Name="HeroCardBorder"
                            Grid.Column="0"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,8,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Верхний блик стеклянной карточки (Glass Shine) -->
                            <Border Grid.RowSpan="3" Height="36" VerticalAlignment="Top" CornerRadius="10,10,0,0"
                                    Background="{DynamicResource CardTopShineBrush}"
                                    IsHitTestVisible="False" Margin="-16,-12,-16,0"/>

                            <DockPanel Grid.Row="0">
                                <TextBlock Text="{Binding LocCurrentPing}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           DockPanel.Dock="Left"
                                           VerticalAlignment="Center"/>

                                <Border Visibility="{Binding DotaMatchBadgeVisibility}"
                                        Background="#2059D499"
                                        BorderBrush="#59D499"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right"
                                        ToolTip="{Binding DotaMatchTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="#59D499" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding DotaMatchBadgeText}"
                                                   Foreground="#59D499"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas, Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                        <TextBlock x:Name="PingText"
                                   Grid.Row="1"
                                   Text="{Binding CurrentPingText}"
                                   Foreground="{Binding CurrentPingForeground}"
                                   FontSize="52"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,4"/>

                        <Border x:Name="StatusBadgeBorder"
                                Grid.Row="2"
                                Background="{Binding StatusBadgeBackground}"
                                BorderBrush="{Binding StatusBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                HorizontalAlignment="Center">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot"
                                         Width="7" Height="7"
                                         Fill="{Binding CurrentPingForeground}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>

                                <TextBlock x:Name="StatusText"
                                           Text="{Binding StatusText}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

                <!-- 5 КАРТОЧЕК МЕТРИК: 3 СВЕРХУ (PING) + 2 СНИЗУ (КАЧЕСТВО СЕТИ) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Ряд 1: Средний, Минимальный, Максимальный -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,4">

                        <!-- Средний -->
                        <Border x:Name="AvgCardBorder"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8" Margin="0,0,3,0" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding LocAvgPing}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="⌀" Foreground="{DynamicResource TextSecondary}"
                                               FontSize="12" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="AverageText"
                                               Text="{Binding AveragePingText}"
                                               Foreground="{Binding AveragePingForeground}"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="AveragePeriodText"
                                               Text="{Binding AveragePeriodText}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="9.5" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Минимальный -->
                        <Border x:Name="MinCardBorder"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8" Margin="3,0,3,0" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding LocMinPing}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="↓" Foreground="{DynamicResource AccentGreen}"
                                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="MinText"
                                               Text="{Binding MinPingText}"
                                               Foreground="{Binding MinPingForeground}"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LocMinBestSuffix}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="9.5" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Максимальный -->
                        <Border x:Name="MaxCardBorder"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8" Margin="3,0,0,0" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding LocMaxPing}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="↑" Foreground="{DynamicResource AccentRed}"
                                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="MaxText"
                                               Text="{Binding MaxPingText}"
                                               Foreground="{Binding MaxPingForeground}"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LocMaxPeakSuffix}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="9.5" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </UniformGrid>

                    <!-- Ряд 2: Потери пакетов (Loss %) и Просадки (>100ms) -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="0,4,0,0">

                        <!-- Потери пакетов (Loss %) -->
                        <Border x:Name="LossCardBorder"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8" Margin="0,0,4,0" Padding="14,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding LocPacketLoss}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PacketLossIcon" Text="⊘"
                                               Foreground="{Binding PacketLossForeground}"
                                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="PacketLossText"
                                               Text="{Binding PacketLossText}"
                                               Foreground="{Binding PacketLossForeground}"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="PacketLossSubText"
                                               Text="{Binding PacketLossSubText}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Просадки (>100ms) -->
                        <Border x:Name="SpikesCardBorder"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8" Margin="4,0,0,0" Padding="14,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding LocSpikes}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="⚠" Foreground="{DynamicResource AccentYellow}"
                                               FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="SpikesText"
                                               Text="{Binding SpikesCountText}"
                                               Foreground="{Binding SpikesCountForeground}"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LocSpikesCountSuffix}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </UniformGrid>

                </Grid>

            </Grid>

            </StackPanel>


            <!-- ===== СТРОКА 2: ГРАФИК PING ===== -->

            <Border x:Name="ChartCardBorder"
                    Grid.Row="1"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Height="188"
                    Margin="0,0,0,10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхний блик стеклянной карточки графика (Glass Shine) -->
                    <Border Grid.RowSpan="2" Height="40" VerticalAlignment="Top" CornerRadius="10,10,0,0"
                            Background="{DynamicResource CardTopShineBrush}"
                            IsHitTestVisible="False" Margin="-14,-10,-14,0"/>

                    <DockPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{Binding LocGraphTitle}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChartSubtitleText"
                                       Text="{Binding ChartSubtitleText}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       Margin="6,1,0,0"
                                       VerticalAlignment="Center"/>

                            <!-- Кнопка возврата в прямой эфир (видна при просмотре истории) -->
                            <Border x:Name="LiveReturnBadge"
                                    Background="#1857C1FF"
                                    BorderBrush="#57C1FF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding LocReturnToLiveTooltip}"
                                    MouseLeftButtonDown="LiveReturnBadge_MouseLeftButtonDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocReturnToLive}"
                                               Foreground="{DynamicResource AccentBlue}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>
                            </Border>

                            <!-- Значение при наведении в заголовке -->
                            <Border x:Name="HoverHeaderBadge"
                                    Background="{DynamicResource BgCardElevated}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HoverHeaderText"
                                           Text=""
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           FontFamily="Consolas, Segoe UI"/>
                            </Border>

                            <!-- Индикатор таймаута / статуса в заголовке графика (когда нет наведения курсора) -->
                            <Border x:Name="ChartLiveStatusBadge"
                                    Background="{Binding ChartLiveStatusBackground}"
                                    BorderBrush="{Binding ChartLiveStatusBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding ChartLiveStatusVisibility}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ChartLiveStatusDot"
                                             Width="6" Height="6"
                                             Margin="0,0,5,0"
                                             Fill="{Binding ChartLiveStatusForeground}"/>
                                    <TextBlock x:Name="ChartLiveStatusText"
                                               Text="{Binding ChartLiveStatusText}"
                                               Foreground="{Binding ChartLiveStatusForeground}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <!-- Сегментный переключатель интервалов времени: 1, 5, 10, 60 мин -->
                            <Border x:Name="ChartIntervalBorder"
                                    Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Interval1mRadio"
                                                 Content="{Binding LocInterval1m}"
                                                 GroupName="ChartIntervalGroup"
                                                 IsChecked="{Binding IsInterval1m, Mode=TwoWay}"
                                                 Style="{StaticResource IntervalRadioBtnStyle}"/>
                                    <RadioButton x:Name="Interval5mRadio"
                                                 Content="{Binding LocInterval5m}"
                                                 GroupName="ChartIntervalGroup"
                                                 IsChecked="{Binding IsInterval5m, Mode=TwoWay}"
                                                 Style="{StaticResource IntervalRadioBtnStyle}"/>
                                    <RadioButton x:Name="Interval10mRadio"
                                                 Content="{Binding LocInterval10m}"
                                                 GroupName="ChartIntervalGroup"
                                                 IsChecked="{Binding IsInterval10m, Mode=TwoWay}"
                                                 Style="{StaticResource IntervalRadioBtnStyle}"/>
                                    <RadioButton x:Name="Interval60mRadio"
                                                 Content="{Binding LocInterval60m}"
                                                 GroupName="ChartIntervalGroup"
                                                 IsChecked="{Binding IsInterval60m, Mode=TwoWay}"
                                                 Style="{StaticResource IntervalRadioBtnStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Width="7" Height="7" CornerRadius="3.5"
                                    Background="{DynamicResource AccentGreen}"
                                    VerticalAlignment="Center" Margin="14,0,5,0"/>
                            <TextBlock Text="{Binding LocIcmpPing}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <!-- Левая панель замера и диагностики (без перекрытия графика) -->
                            <ColumnDefinition Width="195"/>
                            <!-- Тонкий разделитель -->
                            <ColumnDefinition Width="12"/>
                            <!-- Шкала по оси Y -->
                            <ColumnDefinition Width="34"/>
                            <!-- Область графика -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Информационная панель замера и диагностики слева от графика -->
                        <Border x:Name="ChartInfoPanel"
                                Grid.Column="0"
                                Background="{DynamicResource BgCardElevated}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,7"
                                Cursor="Hand"
                                MouseLeftButtonDown="ChartInfoPanel_MouseLeftButtonDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок режима и время -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <TextBlock x:Name="ChartInfoModeText"
                                               Text="В ЭФИРЕ"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="ChartInfoTimeText"
                                                   Text="--:--:--"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ChartInfoAgoText"
                                                   Text="(live)"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="9"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Пинг и статусная индикация -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4" VerticalAlignment="Center">
                                    <Ellipse x:Name="ChartInfoPingDot"
                                             Width="7" Height="7"
                                             Fill="{DynamicResource AccentGreen}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ChartInfoPingText"
                                               Text="-- ms"
                                               Foreground="{DynamicResource AccentGreen}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChartInfoStatusText"
                                               Text="• Стабильно"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <!-- Сегментация сети (Роутер / Провайдер) -->
                                <Border Grid.Row="2"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        Margin="0,0,0,4">
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock Text="🏠 " FontSize="9"/>
                                                <TextBlock Text="{Binding LocRouter}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ChartInfoRouterText"
                                                       Text="-- ms"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>

                                        <DockPanel LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock Text="🏢 " FontSize="9"/>
                                                <TextBlock Text="{Binding LocIsp}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ChartInfoIspText"
                                                       Text="норм"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Кнопки анализа узлов (MTR) и тикета техподдержки -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Кнопка анализа узлов (MTR) -->
                                    <Button x:Name="ChartInfoDiagnosticsBtn"
                                            Grid.Column="0"
                                            Height="22"
                                            Padding="3,0"
                                            Margin="0,0,2,0"
                                            Cursor="Hand"
                                            Click="ChartInfoDiagnosticsBtn_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="#1257C1FF"
                                                        BorderBrush="#3057C1FF"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="2,1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2257C1FF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#6057C1FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#3057C1FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔍 " FontSize="8.5" Foreground="{DynamicResource AccentBlue}"/>
                                            <TextBlock x:Name="ChartInfoActionText"
                                                       Text="{Binding LocAnalyze}"
                                                       Foreground="{DynamicResource AccentBlue}"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Кнопка тикета для провайдера -->
                                    <Button x:Name="ChartInfoIspTicketBtn"
                                            Grid.Column="1"
                                            Height="22"
                                            Padding="3,0"
                                            Margin="2,0,0,0"
                                            Cursor="Hand"
                                            Command="{Binding OpenIspTicketExportCommand}"
                                            ToolTip="{Binding LocIspTicketTooltip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="#1259D499"
                                                        BorderBrush="#3059D499"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="2,1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2259D499"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#6059D499"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#3059D499"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📋 " FontSize="8.5" Foreground="#59D499"/>
                                            <TextBlock Text="Тикет"
                                                       Foreground="#59D499"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Вертикальный разделитель -->
                        <Rectangle Grid.Column="1" Width="1"
                                   Fill="{DynamicResource BorderColor}"
                                   VerticalAlignment="Stretch"
                                   HorizontalAlignment="Center"
                                   Margin="0,3"/>

                        <!-- Шкала по оси Y -->
                        <Canvas x:Name="YAxisCanvas"
                                Grid.Column="2"
                                ClipToBounds="False"/>

                        <!-- Область графика ping и горизонтальный скроллбар истории -->
                        <Grid Grid.Column="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Область графика ping -->
                            <Grid Grid.Row="0"
                                  Background="Transparent"
                                  Cursor="Cross"
                                  MouseMove="PingChart_MouseMove"
                                  MouseEnter="PingChart_MouseEnter"
                                  MouseLeave="PingChart_MouseLeave"
                                  MouseLeftButtonDown="PingChart_MouseLeftButtonDown"
                                  PreviewMouseWheel="PingChart_PreviewMouseWheel"
                                  SizeChanged="PingChart_SizeChanged">

                                <!-- Область графика (линия и градиентная заливка) -->
                                <Canvas x:Name="PingChart"
                                        ClipToBounds="False"
                                        Background="Transparent">

                                    <Polygon x:Name="PingFill" StrokeThickness="0">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2859D499" Offset="0"/>
                                                <GradientStop Color="#0059D499" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>

                                    <Polyline x:Name="PingLine"
                                              Stroke="{StaticResource AccentGreen}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              Points=""/>

                                </Canvas>

                                <!-- Интерактивный оверлей (перекрестие, точка) - без перекрытия графика всплывающим окном -->
                                <Canvas x:Name="HoverOverlayCanvas"
                                        IsHitTestVisible="False"
                                        ClipToBounds="False">

                                    <!-- Вертикальная пунктирная линия шкалы времени -->
                                    <Line x:Name="HoverLine"
                                          Stroke="#353C46"
                                          StrokeThickness="1"
                                          StrokeDashArray="3 2"
                                          Visibility="Collapsed"/>

                                    <!-- Внешний ореол выделенной точки -->
                                    <Ellipse x:Name="HoverDotGlow"
                                             Width="14" Height="14"
                                             Fill="#2059D499"
                                             Stroke="#5059D499"
                                             StrokeThickness="1.5"
                                             Visibility="Collapsed"/>

                                    <!-- Внутренняя точка графика -->
                                    <Ellipse x:Name="HoverDot"
                                             Width="6" Height="6"
                                             Fill="{StaticResource AccentGreen}"
                                             Visibility="Collapsed"/>

                                </Canvas>

                            </Grid>

                            <!-- Горизонтальный скроллбар истории графика -->
                            <ScrollBar x:Name="ChartScrollBar"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Height="14"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource ChartHorizontalScrollBarStyle}"
                                       ValueChanged="ChartScrollBar_ValueChanged"/>

                        </Grid>


                    </Grid>

                </Grid>

            </Border>


            <!-- ===== СТРОКА 3: SDR И ИСТОРИЯ (ПОЛНОЭКРАННЫЙ РЕЗИНОВЫЙ SIDE-BY-SIDE) ===== -->

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- SDR КАРТОЧКА (СЛЕВА) -->
                <Border x:Name="SdrCardBorder"
                        Grid.Column="0"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,6,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- SDR Заголовок и кнопка -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SdrHeaderTitle}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="12" FontWeight="Bold"/>

                                    <Border Background="{DynamicResource AccentBlueSoft}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SdrHeaderBadge}"
                                                   Foreground="{DynamicResource AccentBlue}"
                                                   FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock x:Name="SdrStatusText"
                                               Text="{Binding SdrStatusText}"
                                               Foreground="{Binding SdrStatusForeground}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=" • " Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                    <TextBlock x:Name="SdrTimerText"
                                               Text="{Binding SdrTimerText}"
                                               Foreground="{Binding SdrTimerForeground}"
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocBest}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="BestSdrText"
                                               Text="{Binding BestSdrPingText}"
                                               Foreground="{Binding BestSdrForeground}"
                                               FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>

                                <Button x:Name="RefreshSdrButton"
                                        Padding="9,4"
                                        VerticalAlignment="Center"
                                        Command="{Binding RefreshSdrCommand}"
                                        IsEnabled="{Binding CanRefreshSdr}">
                                    <TextBlock Text="{Binding LocRefresh}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Шапка таблицы SDR (пропорциональная) -->
                        <Grid Grid.Row="1" Margin="8,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocColRegion}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LocColCode}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding LocColPing}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{Binding LocColRoute}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Список серверов SDR (пропорциональный на всю ширину и высоту) -->
                        <ListView x:Name="DotaSdrList"
                                  Grid.Row="2"
                                  ItemsSource="{Binding SdrItems}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#1457C1FF" CornerRadius="3"
                                                Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}"
                                                       Foreground="{DynamicResource AccentBlue}"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Ping}"
                                                   Foreground="{Binding PingColor}"
                                                   FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DisplayRoute}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>

                </Border>


                <!-- ИСТОРИЯ ИЗМЕРЕНИЙ (СПРАВА) -->
                <Border x:Name="HistoryCardBorder"
                        Grid.Column="1"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="6,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{Binding LocHistoryTitle}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="HistoryCountText"
                                       Text="{Binding HistoryCountText}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- Шапка таблицы истории (5 колонок с Потерями) -->
                        <Grid Grid.Row="1" Margin="8,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/> <!-- Время -->
                                <ColumnDefinition Width="0.8*"/> <!-- Отклик -->
                                <ColumnDefinition Width="0.8*"/> <!-- Потери -->
                                <ColumnDefinition Width="1.4*"/> <!-- Статус -->
                                <ColumnDefinition Width="1.7*"/> <!-- Сервер -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocColTime}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LocColPing}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding LocColLoss}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{Binding LocColStatus}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="{Binding LocColServer}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Список истории (пропорциональный на всю ширину и высоту) -->
                        <ListView x:Name="HistoryList"
                                  Grid.Row="2"
                                  ItemsSource="{Binding HistoryItems}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Ping}"
                                                   Foreground="{Binding PingColor}"
                                                   FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="2"
                                                Background="Transparent"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PacketLoss}"
                                                       Foreground="{Binding PacketLossColor}"
                                                       FontFamily="Consolas, Segoe UI"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"/>
                                        </Border>
                                        <Border Grid.Column="3"
                                                Background="{Binding StatusBg}"
                                                BorderBrush="{Binding StatusColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding DisplayServer}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayServer}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>

                </Border>

            </Grid>

        </Grid>


        <!-- =============== TASK MANAGER VIEW (ДИСПЕТЧЕР ЗАДАЧ WINDOWS) =============== -->

        <Grid x:Name="TaskManagerViewContainer"
              Grid.Row="1"
              Margin="18,10,18,14"
              Visibility="{Binding TaskManagerVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 4 системные карточки (ЦП, Память, Диск, Процессы) -->
                <RowDefinition Height="*"/>    <!-- Список процессов Windows -->
                <RowDefinition Height="Auto"/> <!-- Нижний информационный бар -->
            </Grid.RowDefinitions>

            <!-- ===== 1. КАРТОЧКИ СИСТЕМНОЙ ТЕЛЕМЕТРИИ ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- КАРТОЧКА 1: ПРОЦЕССОР (ЦП) -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{Binding CardCornerRadius}"
                        Padding="{Binding CardPadding}"
                        Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding LocProcessorCpu}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalCpuText}" Foreground="{DynamicResource AccentBlue}" FontFamily="Consolas, Segoe UI" FontSize="20" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock Grid.Row="2" Text="{Binding ThreadCountText}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,6"/>
                        <ProgressBar Grid.Row="3" Height="{Binding TelemetryBarHeight}" Minimum="0" Maximum="100" Value="{Binding TotalCpuPercent}"
                                     Background="#171A21" Foreground="{DynamicResource AccentBlue}" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 2: ВИДЕОКАРТА (ГП) -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{Binding CardCornerRadius}"
                        Padding="{Binding CardPadding}"
                        Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding LocGraphicsGpu}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalGpuText}" Foreground="#BD93F9" FontFamily="Consolas, Segoe UI" FontSize="20" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock Grid.Row="2" Text="{Binding LocTotalGpuLoad}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,6"/>
                        <ProgressBar Grid.Row="3" Height="{Binding TelemetryBarHeight}" Minimum="0" Maximum="100" Value="{Binding TotalGpuPercent}"
                                     Background="#171A21" Foreground="#BD93F9" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 3: ОПЕРАТИВНАЯ ПАМЯТЬ (ОЗУ) -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{Binding CardCornerRadius}"
                        Padding="{Binding CardPadding}"
                        Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding LocMemoryRam}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalRamPercent, StringFormat={}{0:F0}%}" Foreground="{DynamicResource AccentGreen}" FontFamily="Consolas, Segoe UI" FontSize="20" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock Grid.Row="2" Text="{Binding TotalRamText}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Row="3" Height="{Binding TelemetryBarHeight}" Minimum="0" Maximum="100" Value="{Binding TotalRamPercent}"
                                     Background="#171A21" Foreground="{DynamicResource AccentGreen}" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 4: ДИСК (СКОРОСТЬ ВВОДА-ВЫВОДА) -->
                <Border Grid.Column="3"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{Binding CardCornerRadius}"
                        Padding="{Binding CardPadding}"
                        Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding LocDiskActivity}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalDiskText}" Foreground="{DynamicResource AccentYellow}" FontFamily="Consolas, Segoe UI" FontSize="20" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock Grid.Row="2" Text="{Binding LocTotalDiskIo}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,6"/>
                        <Border Grid.Row="3" Height="{Binding TelemetryBarHeight}" Background="#171A21" CornerRadius="{Binding CardCornerRadius}">
                            <Border HorizontalAlignment="Left" Width="60" Background="{DynamicResource AccentYellow}" CornerRadius="{Binding CardCornerRadius}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 5: СЕТЬ (СКОРОСТЬ ПЕРЕДАЧИ ДАННЫХ) -->
                <Border Grid.Column="4"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{Binding CardCornerRadius}"
                        Padding="{Binding CardPadding}"
                        Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding LocNetwork}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding TotalNetworkText}" Foreground="{DynamicResource AccentBlue}" FontFamily="Consolas, Segoe UI" FontSize="20" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock Grid.Row="2" Text="{Binding TotalNetworkSubText}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Row="3" Height="{Binding TelemetryBarHeight}" Minimum="0" Maximum="100" Value="{Binding TotalNetworkPercent}"
                                     Background="#171A21" Foreground="{DynamicResource AccentBlue}" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА 6: АКТИВНЫЕ ПРОЦЕССЫ -->
                <Border Grid.Column="5"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{Binding CardCornerRadius}"
                        Padding="{Binding CardPadding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding LocSystem}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding ProcessCountText}" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas, Segoe UI" FontSize="20" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock Grid.Row="2" Text="{Binding ThreadCountText}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,0,6"/>
                        <Border Grid.Row="3" Height="{Binding TelemetryBarHeight}" Background="#171A21" CornerRadius="{Binding CardCornerRadius}">
                            <Border HorizontalAlignment="Left" Width="80" Background="{DynamicResource AccentGreen}" CornerRadius="{Binding CardCornerRadius}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 2. СПИСОК ПРОЦЕССОВ WINDOWS ===== -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="{Binding ContainerCornerRadius}"
                    Padding="{Binding ContainerPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Шапка колонок / сортировка -->
                        <RowDefinition Height="*"/>    <!-- ListView процессов -->
                    </Grid.RowDefinitions>

                    <!-- Шапка таблицы с кликабельными кнопками сортировки -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgCardElevated}"
                            CornerRadius="{Binding TableHeaderCornerRadius}"
                            Padding="{Binding TableHeaderPadding}"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>  <!-- Имя процесса -->
                                <ColumnDefinition Width="70"/>    <!-- ИД (PID) -->
                                <ColumnDefinition Width="80"/>    <!-- ЦП % -->
                                <ColumnDefinition Width="80"/>    <!-- ГП % -->
                                <ColumnDefinition Width="90"/>    <!-- Память -->
                                <ColumnDefinition Width="85"/>    <!-- Диск -->
                                <ColumnDefinition Width="85"/>    <!-- Сеть -->
                                <ColumnDefinition Width="65"/>    <!-- Потоки -->
                                <ColumnDefinition Width="85"/>    <!-- Состояние -->
                            </Grid.ColumnDefinitions>

                            <!-- Сортировка по Имени -->
                            <Button Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Name"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColName}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Сортировка по PID -->
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Pid"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColPid}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Сортировка по CPU -->
                            <Button Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Cpu"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColCpuSort}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Сортировка по GPU -->
                            <Button Grid.Column="3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Gpu"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColGpuSort}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Сортировка по RAM -->
                            <Button Grid.Column="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Ram"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColRamSort}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Сортировка по Disk -->
                            <Button Grid.Column="5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Disk"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColDiskSort}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Сортировка по Network -->
                            <Button Grid.Column="6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SetSortColumnCommand}"
                                    CommandParameter="Network"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LocColNetSort}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" ⇅" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                                </StackPanel>
                            </Button>

                            <!-- Потоки -->
                            <TextBlock Grid.Column="7"
                                        Text="{Binding LocColThreadsSort}"
                                        Foreground="{DynamicResource TextMuted}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Right"/>

                            <!-- Состояние -->
                            <TextBlock Grid.Column="8"
                                        Text="{Binding LocColStateSort}"
                                        Foreground="{DynamicResource TextMuted}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Список процессов с аппаратной виртуализацией 60 FPS -->
                    <ListView x:Name="ProcessesListView"
                              Grid.Row="1"
                              ItemsSource="{Binding Processes}"
                              SelectedItem="{Binding SelectedProcess}"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLengthUnit="Item"
                              VirtualizingPanel.CacheLength="20,20"
                              VirtualizingPanel.IsContainerVirtualizable="True"
                              RenderOptions.ClearTypeHint="Enabled"
                              KeyDown="ProcessesListView_KeyDown">
                        <!-- Фиксированная высота строки 32px для O(1) виртуализации и 60 FPS без layout thrashing -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="UseLayoutRounding" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    CornerRadius="5" Padding="6,2"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A202A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <!-- Контекстное меню процесса -->
                        <ListView.ContextMenu>
                            <ContextMenu Background="{DynamicResource BgCardElevated}"
                                         BorderBrush="{DynamicResource BorderColor}"
                                         BorderThickness="1">
                                <MenuItem Header="{Binding LocEndTask}"
                                          InputGestureText="Del"
                                          Command="{Binding EndTaskCommand}"/>
                                <MenuItem Header="{Binding LocFolderTooltip}"
                                          Command="{Binding OpenProcessLocationCommand}"/>
                                <Separator Background="{DynamicResource BorderSubtle}"/>
                                <MenuItem Header="{Binding LocRefresh}"
                                          InputGestureText="F5"
                                          Command="{Binding RefreshTaskManagerCommand}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding RowMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>  <!-- Имя процесса -->
                                        <ColumnDefinition Width="70"/>    <!-- ИД (PID) -->
                                        <ColumnDefinition Width="80"/>    <!-- ЦП % -->
                                        <ColumnDefinition Width="80"/>    <!-- ГП % -->
                                        <ColumnDefinition Width="90"/>    <!-- Память -->
                                        <ColumnDefinition Width="85"/>    <!-- Диск -->
                                        <ColumnDefinition Width="85"/>    <!-- Сеть -->
                                        <ColumnDefinition Width="65"/>    <!-- Потоки -->
                                        <ColumnDefinition Width="85"/>    <!-- Состояние -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка и Имя процесса (в режиме оптимизации иконка и подстрока пути скрываются для максимальной скорости) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"
                                              Visibility="{Binding IconVisibility}">
                                            <!-- Реальная системная иконка процесса (EXE / Windows Shell) -->
                                            <Image Source="{Binding Icon}"
                                                   Width="20" Height="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   SnapsToDevicePixels="True"/>

                                            <!-- Резервный бейдж с глифом, если иконка не загрузилась -->
                                            <Border Width="22" Height="22"
                                                    CornerRadius="5"
                                                    Background="{DynamicResource BgCardElevated}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedProcessName}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontFamily="{Binding ProcessFontFamily}"
                                                       FontSize="{Binding ProcessNameFontSize}"
                                                       FontWeight="{Binding ProcessNameFontWeight}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="9.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"
                                                       Visibility="{Binding FilePathVisibility}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- PID -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Pid}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                    <!-- ЦП % (с фоновым бейджем тепловой карты) -->
                                    <Border Grid.Column="2"
                                            Background="{Binding CpuBadgeBackground}"
                                            CornerRadius="{Binding BadgeCornerRadius}"
                                            Padding="{Binding BadgePadding}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CpuText}"
                                                   Foreground="{Binding CpuForeground}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <!-- ГП % (с фоновым бейджем тепловой карты) -->
                                    <Border Grid.Column="3"
                                            Background="{Binding GpuBadgeBackground}"
                                            CornerRadius="{Binding BadgeCornerRadius}"
                                            Padding="{Binding BadgePadding}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GpuText}"
                                                   Foreground="{Binding GpuForeground}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <!-- Память (ОЗУ) -->
                                    <Border Grid.Column="4"
                                            Background="{Binding RamBadgeBackground}"
                                            CornerRadius="{Binding BadgeCornerRadius}"
                                            Padding="{Binding BadgePadding}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RamText}"
                                                   Foreground="{Binding RamForeground}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Диск (I/O) -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding DiskText}"
                                               Foreground="{Binding DiskForeground}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <!-- Сеть -->
                                    <Border Grid.Column="6"
                                            Background="{Binding NetworkBadgeBackground}"
                                            CornerRadius="{Binding BadgeCornerRadius}"
                                            Padding="{Binding BadgePadding}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NetworkText}"
                                                   Foreground="{Binding NetworkForeground}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Потоки -->
                                    <TextBlock Grid.Column="7"
                                               Text="{Binding ThreadsCount}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <!-- Состояние -->
                                    <Border Grid.Column="8"
                                            Background="{Binding StatusBadgeBackground}"
                                            CornerRadius="{Binding BadgeCornerRadius}"
                                            Padding="{Binding BadgePadding}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusForeground}"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"/>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            <!-- ===== 3. СТРОКА СТАТУСА ДИСПЕТЧЕРА ЗАДАЧ ===== -->
            <Border Grid.Row="2" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock Text="{Binding TaskManagerStatusMessage}"
                               Foreground="{DynamicResource AccentYellow}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LocEndTaskTooltip}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10.5"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

        </Grid>


        <!-- =============== SPEEDTEST VIEW (СПИДТЕСТ СЕТИ) =============== -->

        <ScrollViewer x:Name="SpeedtestViewContainer"
                      Grid.Row="1"
                      Margin="18,10,18,14"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding SpeedtestVisibility}">

            <StackPanel>

                <!-- ===== 1. КАРТОЧКИ ИТОГОВЫХ МЕТРИК ===== -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Карточка 1: Download -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="↓ " Foreground="{DynamicResource AccentGreen}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LocSpeedtestDownload}" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeedtestDownloadText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="22" FontWeight="Bold"
                                       Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LocSpeedtestPeak}" Foreground="{DynamicResource TextMuted}" FontSize="9.5"/>
                                <TextBlock Text=": " Foreground="{DynamicResource TextMuted}" FontSize="9.5"/>
                                <TextBlock Text="{Binding SpeedtestDownloadPeakText}" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 2: Upload -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="3,0,3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="↑ " Foreground="{DynamicResource AccentBlue}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LocSpeedtestUpload}" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeedtestUploadText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="22" FontWeight="Bold"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding LocSpeedtestAverage}" Foreground="{DynamicResource TextMuted}" FontSize="9.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 3: Ping & Jitter -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="3,0,3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="⚡ " Foreground="{DynamicResource AccentYellow}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LocSpeedtestPing}" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeedtestPingText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="22" FontWeight="Bold"
                                       Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Jitter: " Foreground="{DynamicResource TextMuted}" FontSize="9.5"/>
                                <TextBlock Text="{Binding SpeedtestJitterText}" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bufferbloat: " Foreground="{DynamicResource TextMuted}" FontSize="9.5"/>
                                <TextBlock Text="{Binding SpeedtestBufferbloatText}" Foreground="{Binding SpeedtestBufferbloatForeground}" FontSize="9.5" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SpeedtestBufferbloatGrade}" Foreground="{Binding SpeedtestBufferbloatForeground}" FontSize="8.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 4: Provider & Server -->
                    <Border Grid.Column="3"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="🌐 " FontSize="11"/>
                                <TextBlock Text="{Binding LocSpeedtestIsp}" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeedtestIspName}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding SpeedtestServerLocation}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 2. ЦЕНТРАЛЬНЫЙ БЛОК: РАДИАЛЬНЫЙ СПИДОМЕТР, ЦИФРОВОЙ СЧЕТЧИК И КНОПКА СТАРТ ===== -->
                <Border Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Радиальный спидометр со шкалой -->
                        <Grid Grid.Row="0" Width="260" Height="200" HorizontalAlignment="Center">
                            <!-- Фоновая круговая дуга (от 0 до 1000+ Мбит/с) -->
                            <Path Data="M 43,190 A 100,100 0 1,1 217,190"
                                  Stroke="{DynamicResource BorderColor}"
                                  StrokeThickness="7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>

                            <!-- Метки скоростей вокруг шкалы -->
                            <Canvas Width="260" Height="200">
                                <TextBlock Text="0" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Canvas.Left="20" Canvas.Top="186"/>
                                <TextBlock Text="10" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Canvas.Left="10" Canvas.Top="110"/>
                                <TextBlock Text="50" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Canvas.Left="60" Canvas.Top="46"/>
                                <TextBlock Text="100" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="Bold" Canvas.Left="120" Canvas.Top="24"/>
                                <TextBlock Text="250" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Canvas.Left="196" Canvas.Top="46"/>
                                <TextBlock Text="500" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Canvas.Left="232" Canvas.Top="110"/>
                                <TextBlock Text="1000+" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Canvas.Left="216" Canvas.Top="186"/>
                            </Canvas>

                            <!-- Стрелка спидометра (вращение от -120° до +120°) -->
                            <Border Width="3" Height="75"
                                    Background="{DynamicResource AccentColorBrush}"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,65,0,0">
                                <Border.RenderTransform>
                                    <RotateTransform CenterX="1.5" CenterY="75" Angle="{Binding SpeedtestGaugeAngle}"/>
                                </Border.RenderTransform>
                            </Border>

                            <!-- Центральная втулка стрелки -->
                            <Ellipse Width="16" Height="16"
                                     Fill="{DynamicResource BgCardElevated}"
                                     Stroke="{DynamicResource AccentColorBrush}"
                                     StrokeThickness="2.5"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,132,0,0"/>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource AccentColorBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,137,0,0"/>
                        </Grid>

                        <!-- Цифровой счетчик текущей скорости (моноширинный tabular-nums) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-10,0,4">
                            <TextBlock Text="{Binding SpeedtestHeroSpeedText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="Consolas, Segoe UI Variable, Segoe UI, sans-serif"
                                       FontSize="46" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SpeedtestHeroUnitText}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,8"/>
                        </StackPanel>

                        <!-- Бейдж текущей фазы замера -->
                        <Border Grid.Row="2"
                                Background="{Binding SpeedtestPhaseBadgeBackground}"
                                BorderBrush="{Binding SpeedtestPhaseBadgeForeground}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,4"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding SpeedtestPhaseBadgeText}"
                                       Foreground="{Binding SpeedtestPhaseBadgeForeground}"
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <!-- Кнопка запуска / отмены замера с неоновым темным стилем -->
                        <Button Grid.Row="3"
                                HorizontalAlignment="Center"
                                Command="{Binding ToggleSpeedtestCommand}"
                                Style="{StaticResource SpeedtestActionButtonStyle}"/>

                    </Grid>
                </Border>

                <!-- ===== 3. ГРАФИК ВОЛНЫ СКОРОСТИ В РЕАЛЬНОМ ВРЕМЕНИ ===== -->
                <Border Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="〰 " Foreground="{DynamicResource AccentBlue}" FontSize="12"/>
                            <TextBlock Text="{Binding LocSpeedtestWaveGraph}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10.5" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Холст волны скорости: сглаженный кубический сплайн Безье с затухающим градиентом -->
                        <Border Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Height="66"
                                Padding="2">
                            <Viewbox Stretch="Fill" Height="62">
                                <Canvas Width="680" Height="64" ClipToBounds="True">
                                    <!-- Горизонтальная направляющая сетки (средняя линия) -->
                                    <Line X1="0" Y1="32" X2="680" Y2="32"
                                          Stroke="{DynamicResource BorderSubtle}"
                                          StrokeThickness="1"
                                          StrokeDashArray="4 4"/>
                                    <!-- Векторная затухающая заливка под кубическим сплайном -->
                                    <Path Data="{Binding SpeedtestWaveFillGeometry}"
                                          Fill="{Binding SpeedtestWaveFillBrush}"/>
                                    <!-- Сглаженная кубическая кривая Безье верхней волны -->
                                    <Path Data="{Binding SpeedtestWaveStrokeGeometry}"
                                          Stroke="{DynamicResource AccentColorBrush}"
                                          StrokeThickness="2.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource AccentColorValue}" Opacity="0.4"/>
                                        </Path.Effect>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 4. ИСТОРИЯ ЗАМЕРОВ СКОРОСТИ ===== -->
                <Border Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding LocSpeedtestHistoryTitle}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10.5" FontWeight="Bold"
                                       DockPanel.Dock="Left"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding ClearSpeedtestHistoryCommand}"
                                    Padding="8,3"
                                    Height="24"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding SpeedtestHistoryListVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑 " FontSize="10"/>
                                    <TextBlock Text="{Binding LocSpeedtestClearHistory}" FontSize="10"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Список истории замеров -->
                        <Grid Visibility="{Binding SpeedtestHistoryListVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка таблицы истории -->
                            <Grid Grid.Row="0" Margin="8,0,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LocColTime}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LocSpeedtestColDownload}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding LocSpeedtestColPeak}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding LocSpeedtestColUpload}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="{Binding LocSpeedtestColPing}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="5" Text="{Binding LocSpeedtestColJitter}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="6" Text="{Binding LocSpeedtestColServer}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Строки таблицы истории -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding SpeedtestHistoryItems}"
                                      MaxHeight="180"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedDate}" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadText}" Foreground="{DynamicResource AccentGreen}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadPeakText}" Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UploadText}" Foreground="{DynamicResource AccentBlue}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PingText}" Foreground="{DynamicResource AccentYellow}" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding JitterText}" Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding ServerFullText}" Foreground="{DynamicResource TextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Заглушка если истории еще нет -->
                        <Border Visibility="{Binding SpeedtestNoHistoryVisibility}"
                                Padding="20"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⏱" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding LocSpeedtestNoHistory}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</Window>