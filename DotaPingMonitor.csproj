<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PingMonitoring</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Ping Monitoring</AssemblyTitle>
    <Product>Ping Monitoring</Product>
    <Description>Ping Monitoring - Network, Game SDR Telemetry, Task Manager &amp; Speedtest</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Ping Monitoring</Company>
    <Copyright>Copyright © 2026 Ping Monitoring. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncPublishOnBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(PublishProtocol)' == ''">
    <ItemGroup>
      <_BuildOutputFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)win-x64\**;$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_BuildOutputFiles)" 
          DestinationFiles="@(_BuildOutputFiles->'$(MSBuildProjectDirectory)\publish\%(RecursiveDir)%(Filename)%(Extension)')" 
          SkipUnchangedFiles="true" 
          ContinueOnError="true" />
  </Target>

</Project>
